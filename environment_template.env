# OncoPilot MCP System Environment Configuration
# Copy this file to .env and fill in your actual values

# ================================
# DATABASE CONFIGURATION
# ================================
# MongoDB connection string for the oncology database
MONGODB_URI=mongodb+srv://REDACTED:REDACTED@REDACTED-CLUSTER.mongodb.net/
DATABASE_NAME=oncopilot-agent

# ================================
# EXTERNAL API KEYS (Optional)
# ================================
# SerpAPI for enhanced web search (optional)
SERPAPI_KEY=your_serpapi_key_here

# NCBI API key for PubMed access (optional, improves rate limits)
NCBI_API_KEY=your_ncbi_api_key_here

# ================================
# APPLICATION CONFIGURATION
# ================================
# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Streamlit configuration
STREAMLIT_PORT=8501
STREAMLIT_HOST=0.0.0.0

# Cache settings
ENABLE_QUERY_CACHE=true
CACHE_TTL_SECONDS=3600

# ================================
# MCP SERVER CONFIGURATION
# ================================
# FastMCP server timeout settings
MCP_TIMEOUT_SECONDS=30
MCP_MAX_RETRIES=3

# Performance settings
MAX_CONCURRENT_QUERIES=5
MAX_ENTITIES_PER_QUERY=5
MAX_INTENTS_PER_QUERY=8

# ================================
# SECURITY SETTINGS
# ================================
# API rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Enable/disable external sources
ENABLE_WEB_SEARCH=true
ENABLE_PUBMED_SEARCH=true
ENABLE_CLINICAL_TRIALS=true

# ================================
# DEVELOPMENT SETTINGS
# ================================
# Enable debug mode for development
DEBUG_MODE=false

# Enable detailed logging for MCP servers
ENABLE_MCP_DEBUG=false

# Mock external APIs for testing (true/false)
MOCK_EXTERNAL_APIS=false 